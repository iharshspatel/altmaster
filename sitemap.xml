---
# Front matter makes Jekyll process the Liquid below. Blog entries are generated
# from the posts collection, so publishing a post adds it here automatically.
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://altmaster.io/</loc>
    <lastmod>2026-06-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://altmaster.io/alt-text-checker/</loc>
    <lastmod>2026-06-10</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://altmaster.io/blog/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{%- for post in site.posts %}
  <url>
    <loc>https://altmaster.io{{ post.url }}</loc>
    <lastmod>{{ post.modified | default: post.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
  <url>
    <loc>https://altmaster.io/about/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://altmaster.io/contact/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>https://altmaster.io/privacy/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
